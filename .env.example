# Optional external AI. Configure these as hosted Sites secrets/environment values.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative provider:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Remote MCP stays disabled unless both values are configured server-side.
# This static Bearer mode is suitable for trusted external MCP clients and probes.
# Do not expose the token in source, UI, logs, or chat.
REMOTE_MCP_BEARER_TOKEN=
REMOTE_MCP_WORKSPACE_ID=
# Optional comma-separated browser origins. Server-to-server MCP clients omit Origin.
REMOTE_MCP_ALLOWED_ORIGINS=

# Workspace alignment:
# Browser UI/WebMCP use the HttpOnly `dialog_index_workspace` cookie.
# To make Remote MCP read/write the same data, configure REMOTE_MCP_WORKSPACE_ID
# to the workspaceId returned by POST /api/session for the intended browser profile.
# /api/health reports authentication.workspaceMatchesSession as true/false.

# ChatGPT Custom MCP App note:
# Static Bearer does not implement the OAuth 2.1 discovery/token flow expected for
# authenticated ChatGPT MCP apps. Add an established OAuth provider before claiming
# ordinary-chat Custom App connectivity.
