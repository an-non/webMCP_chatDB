# Optional external AI. Configure these as hosted Sites secrets/environment values.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative provider:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Shared Remote MCP workspace. This MUST match the browser/WebMCP workspace
# if ordinary-chat MCP and Site Tools should operate on the same records.
REMOTE_MCP_WORKSPACE_ID=

# Trusted external MCP client/probe compatibility. Optional when OAuth is configured.
# Do not expose this token in source, UI, logs, README, or chat.
REMOTE_MCP_BEARER_TOKEN=
# Optional comma-separated browser origins. Server-to-server MCP clients omit Origin.
REMOTE_MCP_ALLOWED_ORIGINS=

# ChatGPT Custom App / OAuth 2.1.
# Use a long random server-side signing secret distinct from other credentials.
REMOTE_MCP_OAUTH_SIGNING_SECRET=

# Single-owner authorization fallback. Set a private code in the Sites environment;
# the OAuth consent page asks for it. Never commit or paste the real value into chat.
REMOTE_MCP_OAUTH_APPROVAL_CODE=
REMOTE_MCP_OAUTH_SUBJECT=dialog-index-owner

# Optional alternative/extra gate when the Site supplies authenticated user headers.
# Comma-separated lower-case email allowlist. If configured, matching signed-in users
# can approve without the manual approval code.
REMOTE_MCP_OAUTH_ALLOWED_EMAILS=

# Workspace alignment:
# Browser UI/WebMCP use the HttpOnly `dialog_index_workspace` cookie.
# Configure REMOTE_MCP_WORKSPACE_ID to the workspaceId returned by POST /api/session
# for the intended browser profile. /api/health reports workspaceMatchesSession.

# OAuth endpoints published by this app after deployment:
# /.well-known/oauth-protected-resource
# /.well-known/oauth-authorization-server
# /oauth/register
# /oauth/authorize
# /oauth/token
# /mcp
