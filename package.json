{
  "name": "dialog-index-mcp",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "check": "npm run typecheck && npm run build",
    "validate:static": "node scripts/validate-static.mjs",
    "validate:mcp": "node --experimental-strip-types scripts/validate-mcp.ts",
    "probe:production": "node scripts/probe-production.mjs",
    "validate:ui": "node scripts/validate-ui-session-order.mjs",
    "validate": "npm run validate:static && npm run validate:ui && npm run validate:mcp"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
